{
  "name": "folix",
  "version": "0.1.0",
  "private": true,
  "description": "Folix turns a person's career details into a published portfolio website.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:dashes": "node scripts/check-em-dash.mjs",
    "check": "pnpm format:check && pnpm check:dashes && turbo run lint typecheck test",
    "db:generate": "pnpm --filter @folix/db db:generate",
    "db:migrate": "pnpm --filter @folix/db db:migrate",
    "db:studio": "pnpm --filter @folix/db db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.11"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
