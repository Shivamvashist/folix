# Copy to .env.local and fill in. Never commit real values.
# Full reference: docs/engineering/environment.md

# Public URL of the app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string (Neon: use the pooled connection string).
DATABASE_URL=postgresql://user:password@host/folix?sslmode=require

# Session signing secret, at least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in (optional). Redirect URI: <app url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in (optional). Callback URL: <app url>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email magic links (optional in development: links print to the server console).
RESEND_API_KEY=
EMAIL_FROM=Folix <onboarding@resend.dev>
